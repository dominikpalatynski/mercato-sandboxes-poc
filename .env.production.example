# =============================================================================
# Mercato Sandboxes — PRODUCTION env template.
#
# Copy to `.env.production` on the Hetzner VPS and fill in the marked values.
# This file is loaded by `scripts/deploy-hetzner.sh` and by every
# `docker compose -f docker-compose.yml -f docker-compose.prod.yml` invocation
# on the box.
#
# DO NOT COMMIT the resulting .env.production — it contains:
#   * a Cloudflare API token (DNS-edit scope, sandbox.openmercato.com only)
#   * a Coder admin password
#   * a JWT secret
#   * AI provider keys
#
# Naming: this file lives at `.env.production.example`; the real file should
# be `.env.production` (gitignored — see .gitignore — same as `.env`).
# =============================================================================

# --- Domain & TLS ------------------------------------------------------------
# Apex sandbox domain. A wildcard A record `*.<SANDBOX_DOMAIN>` MUST point at
# this VPS's public IP, AND a record for `<SANDBOX_DOMAIN>` itself (apex)
# also pointing at the VPS. Caddy uses DNS-01 to issue ONE wildcard cert.
SANDBOX_DOMAIN=sandbox.openmercato.com
CADDY_SCHEME=https
CADDY_PORT_SUFFIX=
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Email used by Let's Encrypt for cert expiration notices. Required.
CADDY_ACME_EMAIL=ops@openmercato.com

# Cloudflare API token with DNS:Edit scope on the SANDBOX_DOMAIN zone. Used
# by caddy-dns/cloudflare for the DNS-01 challenge. Get one from:
#   https://dash.cloudflare.com/profile/api-tokens
# Template: "Edit zone DNS" — Zone Resources: Include — Specific zone —
#   sandbox.openmercato.com (or its parent).
CLOUDFLARE_API_TOKEN=REPLACE_ME

# (Optional) Override during smoke testing to avoid LE rate limits:
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# DNS provider plugin baked into the custom caddy image. Switch to e.g.
# `route53`, `digitalocean`, `gandi`, etc. by changing this AND providing the
# matching API token env var (see docker-compose.prod.yml for plumbing).
CADDY_DNS_PROVIDER=cloudflare

# Pinned image tags so a redeploy is reproducible. Bump intentionally.
CADDY_IMAGE_TAG=latest
CODER_IMAGE_TAG=v2.21.3

# --- Coder control plane -----------------------------------------------------
# Public URL the workspaces (and end users) use to reach Coder. caddy
# publishes Coder at https://coder.<SANDBOX_DOMAIN> via docker labels.
CODER_ACCESS_URL=https://coder.sandbox.openmercato.com

# First admin user — created on the FIRST deploy by bootstrap-coder.sh.
# Ignored on subsequent deploys (the user already exists). Change the
# password BEFORE the first deploy; do NOT roll it after — there is no
# password-rotation flow in the POC.
CODER_FIRST_USER_EMAIL=admin@openmercato.com
CODER_FIRST_USER_USERNAME=admin
CODER_FIRST_USER_PASSWORD=CHANGE_ME_BEFORE_FIRST_DEPLOY

# --- Onboarding app ----------------------------------------------------------
# JWT secret for the onboarding session cookie. MUST be 32+ characters.
# Rotating it logs every onboarding user out (Coder users are unaffected).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Public Coder URL embedded into onboarding-rendered links — same as
# CODER_ACCESS_URL above (workspaces use it for code-server / terminal links).
CODER_PUBLIC_URL=https://coder.sandbox.openmercato.com

# Onboarding DB — internal only in prod (no host port mapping). Credentials
# are still required so the onboarding container can connect over the
# `control` docker network.
ONBOARDING_DB_USER=onboarding
ONBOARDING_DB_PASSWORD=CHANGE_ME_RANDOM
ONBOARDING_DB_NAME=onboarding

# --- AI keys (forwarded into every workspace) --------------------------------
# Used by the preinstalled opencode / codex / claude CLIs inside each
# workspace. Optional but recommended — without them the AI CLIs error out.
# Keys are pushed into the Coder template on every deploy via push-template.sh.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Workspace image ---------------------------------------------------------
MERCATO_WORKSPACE_IMAGE=mercato-workspace:latest
MERCATO_CREATE_CMD="npx -y create-mercato-app@develop"
