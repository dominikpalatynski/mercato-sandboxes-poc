# Coder control plane
# CODER_HTTP_PORT is unused in the all-Traefik setup (no host port mapping).
# Browser reaches Coder at http(s)://coder.${SANDBOX_DOMAIN} via Traefik.
CODER_ACCESS_URL=http://coder.sandbox.lvh.me
CODER_WILDCARD_ACCESS_URL=*.apps.sandbox.lvh.me
CODER_FIRST_USER_EMAIL=admin@local.dev
CODER_FIRST_USER_USERNAME=admin
CODER_FIRST_USER_PASSWORD=Sup3rSecret!

# Onboarding postgres (host-side)
ONBOARDING_DB_PORT=5545
ONBOARDING_DB_USER=onboarding
ONBOARDING_DB_PASSWORD=onboarding
ONBOARDING_DB_NAME=onboarding

# Onboarding app
ONBOARDING_HTTP_PORT=3000
JWT_SECRET=change-me-in-prod-please-32chars-min
# URL the end user opens in their browser to reach Coder (links rendered by the onboarding app).
CODER_PUBLIC_URL=http://coder.sandbox.lvh.me

# Workspace image
MERCATO_WORKSPACE_IMAGE=mercato-workspace:latest
MERCATO_CREATE_CMD="npx -y create-mercato-app@develop"

# AI keys forwarded into each workspace (used by opencode/codex/claude CLIs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Networking — Traefik publishes everything under <name>.<SANDBOX_DOMAIN>:
#   sandbox.lvh.me                     → onboarding
#   coder.sandbox.lvh.me               → Coder UI
#   <ws>.sandbox.lvh.me                → workspace app (:3000)
#   <ws>-splash.sandbox.lvh.me         → workspace splash (:4000)
#   <ws>-code.sandbox.lvh.me           → workspace VS Code (:13337)
# Local dev: lvh.me wildcards every subdomain to 127.0.0.1 — no DNS setup.
# Prod: set SANDBOX_DOMAIN=sandbox.example.com (with *.sandbox.example.com
#       wildcard A), PROXY_SCHEME=https, TRAEFIK_ENTRYPOINT=websecure,
#       and configure Cloudflare DNS-01 in docker-compose.prod.yml.
# ---------------------------------------------------------------------------
SANDBOX_DOMAIN=sandbox.lvh.me
PROXY_SCHEME=http
# Optional URL port suffix (e.g. ":8080" if you can't bind 80). Empty for 80/443.
PROXY_PORT_SUFFIX=
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
# Traefik entrypoint workspace services attach to. `web` = HTTP-only (dev),
# `websecure` = HTTPS via the configured certresolver (prod).
TRAEFIK_ENTRYPOINT=web
