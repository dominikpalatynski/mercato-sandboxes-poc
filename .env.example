# Coder control plane
CODER_HTTP_PORT=7080
CODER_ACCESS_URL=http://host.docker.internal:7080
CODER_FIRST_USER_EMAIL=admin@local.dev
CODER_FIRST_USER_USERNAME=admin
CODER_FIRST_USER_PASSWORD=Sup3rSecret!

# Onboarding postgres (host-side)
ONBOARDING_DB_PORT=5544
ONBOARDING_DB_USER=onboarding
ONBOARDING_DB_PASSWORD=onboarding
ONBOARDING_DB_NAME=onboarding

# Onboarding app
ONBOARDING_HTTP_PORT=3000
JWT_SECRET=change-me-in-prod-please-32chars-min

# Workspace image
MERCATO_WORKSPACE_IMAGE=mercato-workspace:latest
MERCATO_CREATE_CMD="npx -y create-mercato-app@develop"
