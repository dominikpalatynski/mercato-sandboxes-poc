# Coder control plane
# Browser reaches Coder at https://coder.${SANDBOX_DOMAIN} via the edge proxy.
CODER_ACCESS_URL=https://coder.sandbox.lvh.me
CODER_WILDCARD_ACCESS_URL=*.apps.sandbox.lvh.me
CODER_FIRST_USER_EMAIL=admin@local.dev
CODER_FIRST_USER_USERNAME=admin
CODER_FIRST_USER_PASSWORD=Sup3rSecret!

# Onboarding postgres (host-side)
ONBOARDING_DB_PORT=5545
ONBOARDING_DB_USER=onboarding
ONBOARDING_DB_PASSWORD=onboarding
ONBOARDING_DB_NAME=onboarding

# Onboarding app
ONBOARDING_HTTP_PORT=3000
JWT_SECRET=change-me-in-prod-please-32chars-min
# URL the end user opens in their browser to reach Coder (links rendered by the onboarding app).
CODER_PUBLIC_URL=https://coder.sandbox.lvh.me
# URL workspace containers use to download/connect the Coder agent.
# Leave empty locally: the template defaults to http://coder.${SANDBOX_DOMAIN}
# on the shared Docker network, while browsers still use CODER_PUBLIC_URL.
AGENT_CODER_URL=

# Workspace image
MERCATO_WORKSPACE_IMAGE=mercato-workspace:latest
MERCATO_CREATE_CMD="npx -y create-mercato-app@develop"

# AI billing / OpenRouter
# Management key used by apps/onboarding to create and manage per-user
# OpenRouter inference keys.
OPENROUTER_MANAGEMENT_KEY=
# Optional override. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# PayByLink checkout + webhook signing
# For local checkout testing with the mock:
#   node scripts/mock-paybylink.js
#   PAYBYLINK_API_BASE_URL=http://127.0.0.1:9999/api/v1
PAYBYLINK_API_BASE_URL=
PAYBYLINK_SHOP_ID=
PAYBYLINK_PRIVATE_KEY=
# Optional override. Defaults to sha256.
PAYBYLINK_SIGNATURE_ALGORITHM=

# Billing settings
# Protects POST /api/internal/billing/sync-usage via x-billing-sync-secret.
BILLING_SYNC_SECRET=change-me-local-sync-secret
# Optional pricing knobs.
BILLING_USD_TO_PLN_RATE=4.0
BILLING_ACTIVATION_FEE_PLN=0

# ---------------------------------------------------------------------------
# Networking — the edge proxy handles three host categories:
#   sandbox.lvh.me                       → onboarding
#   coder.sandbox.lvh.me                 → Coder UI
#   *.apps.sandbox.lvh.me                → Coder wildcard proxy
#
# Per-workspace URLs live under Coder's wildcard access URL feature in
# port-based form: {port}--main--{ws}--{user}.${WILDCARD_APPS_DOMAIN}
#   3000--main--<ws>--<user>.apps.sandbox.lvh.me   → workspace app    (:3000)
#   4000--main--<ws>--<user>.apps.sandbox.lvh.me   → workspace splash (:4000)
#   13337--main--<ws>--<user>.apps.sandbox.lvh.me  → workspace VS Code (:13337)
#
# Local dev: lvh.me wildcards every subdomain to 127.0.0.1 — no DNS setup.
# Prod: set SANDBOX_DOMAIN=sandbox.example.com plus matching DNS wildcards
#       (`*.sandbox.example.com` AND `*.apps.sandbox.example.com`) and
#       terminate TLS in the chosen edge proxy.
# ---------------------------------------------------------------------------
SANDBOX_DOMAIN=sandbox.lvh.me
WILDCARD_APPS_DOMAIN=apps.sandbox.lvh.me
PROXY_SCHEME=https
COOKIE_DOMAIN=.sandbox.lvh.me
COOKIE_SECURE=true
# Optional URL port suffix. Empty for standard 80/443.
PROXY_PORT_SUFFIX=
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
